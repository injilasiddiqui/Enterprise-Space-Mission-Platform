  "target": "health_status",
  "classes": [
    "Healthy",
    "Warning",
    "Critical"
  ],
  "accuracy": 0.923,
  "precision": 0.9231,
  "recall": 0.923,
  "f1_score": 0.923,
  "status": "Active"
}