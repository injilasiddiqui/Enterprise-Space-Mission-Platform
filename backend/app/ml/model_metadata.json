{
  "model_name": "Satellite Predictive Maintenance Random Forest",
  "model_version": "1.0.0",
  "algorithm": "RandomForestClassifier",
  "dataset_type": "Simulated Satellite Telemetry",
  "total_samples": 5000,
  "training_split": 0.8,
  "testing_split": 0.2,
  "features": [
    "battery",
    "temperature",
    "solar_panel"
